// Stage 4 (maps) and Stage 7 (match history) add more models on top of this.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  rating       Int      @default(1000)
  createdAt    DateTime @default(now())
}
