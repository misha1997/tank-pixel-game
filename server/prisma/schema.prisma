// Prisma schema — models land starting with Stage 1 (accounts) and Stage 4 (maps) / Stage 7 (matches).
// Kept empty on purpose for Stage 0: this only wires up the toolchain (generate/migrate) against Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
